#!/usr/bin/env bash
# 推送到 main 前检查 Vercel 构建队列：已有排队/构建时默认拦下，避免把队列压得更长。
# 强制推送：DEPLOY_FORCE=1 git push ...（生产流水线内部会带这个变量）
set -uo pipefail

FORCE="${DEPLOY_FORCE:-0}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# 品牌资产体检（2026-11-25 加，fail-closed，毫秒级）：favicon 的 PNG 帧不是 RGBA 会让
# Turbopack 直接中止构建（当天挂了两次生产部署）。这一步不受 DEPLOY_FORCE 影响，
# 也不该被绕过——它不是预算/排队问题，是“推上去必然炸”。
if [ -f "$ROOT/scripts/check-build-assets.py" ]; then
    if ! python3 "$ROOT/scripts/check-build-assets.py" >&2; then
        echo "⛔ 品牌资产体检未通过（构建必炸），push 已拦截。" >&2
        exit 1
    fi
fi

[ "$FORCE" = "1" ] && exit 0

REMOTE="$1"; URL="$2"
case "$REMOTE" in origin|upstream) ;; *) exit 0 ;; esac
case "$URL" in *tradego-fasteners-v2*) ;; *) exit 0 ;; esac

# 2026-11-25 规范合规(docs/VERCEL-OPS.md): 直推也要过一遍规范自检。
# 返回 2 仅代表有警告（如工作区有未提交文件），允许继续；返回 1 为硬性违规，拦截。
if [ -x "$ROOT/scripts/vercel-guard.sh" ]; then
    bash "$ROOT/scripts/vercel-guard.sh"
    GUARD_RC=$?
    if [ "$GUARD_RC" -eq 1 ]; then
        echo "⛔ 规范自检未通过（见上方输出与 docs/VERCEL-OPS.md），push 已拦截。"
        exit 1
    fi
fi

# 2026-11-25: 直推也要过部署预算闸门（只读校验，不计数）。
# 之前只有 deploy-flush 内部查预算，脚本里裸的 git push 可以随便多推 —— 当天因此跑了 7 次构建。
# 想明确强行推送：DEPLOY_FORCE=1 git push / DEPLOY_SKIP_BUDGET=1 git push
if [ "${DEPLOY_SKIP_BUDGET:-0}" != "1" ] && [ -f "$ROOT/scripts/deploy-budget.sh" ]; then
    if ! DEPLOY_BUDGET_READONLY=1 bash "$ROOT/scripts/deploy-budget.sh" >&2; then
        echo "⛔ 当日部署预算已用完，本次 push 被拦住。"
        echo "   合并提交等下一个窗口，或确认要烧额度时：DEPLOY_FORCE=1 git push"
        exit 1
    fi
fi

# FAQ 伪翻译归一化（不阻断）：把"非英文语种=英文原文"的副本清掉，再查泄漏
if [ -f "$ROOT/scripts/normalize-faq-i18n.py" ]; then
    CHANGED=$(git diff --name-only "$(git merge-base HEAD origin/main 2>/dev/null || echo HEAD)" HEAD -- content/articles 2>/dev/null | sed "s|^|$ROOT/|" | paste -sd, -)
    [ -n "$CHANGED" ] && python3 "$ROOT/scripts/normalize-faq-i18n.py" --apply --paths "$CHANGED" >/dev/null 2>&1 || true
fi

# CTA 伪翻译巡检（不阻断）：只报告不写盘，避免 pre-push 弄脏工作区
if [ -f "$ROOT/scripts/normalize-cta-i18n.py" ]; then
    CTA_LINE=$(python3 "$ROOT/scripts/normalize-cta-i18n.py" 2>/dev/null | head -1)
    case "$CTA_LINE" in
        *" 0 处"*) ;;
        "") ;;
        *) echo "⚠️  CTA 伪翻译待清理：${CTA_LINE}（python3 scripts/normalize-cta-i18n.py --apply）" ;;
    esac
fi

# 内容契约软提示（不阻断）：非英文语种的 FAQ 仍是英文原文时提示一下
if [ -f "$ROOT/scripts/check-i18n-leakage.py" ]; then
    LEAK=$(python3 "$ROOT/scripts/check-i18n-leakage.py" 2>/dev/null | awk '/^  (zh|ja|es|fr|pt|ar|ru|de|hi) /{s+=$2} END{print s+0}')
    [ "${LEAK:-0}" -gt 0 ] && echo "⚠️  FAQ 本地化缺口：${LEAK} 条（python3 scripts/check-i18n-leakage.py --fix-list 看明细）"
fi

# 正文体检软提示（不阻断）：整句英文残留 / 摘要级正文
if [ -f "$ROOT/scripts/check-body-lang.py" ]; then
    BL=$(python3 "$ROOT/scripts/check-body-lang.py" 2>/dev/null | head -1)
    case "$BL" in
        *"english 0 处"*) ;;
        *) echo "⚠️  正文语种残留：${BL}" ;;
    esac
fi
if [ -f "$ROOT/scripts/check-body-len.py" ]; then
    SL=$(python3 "$ROOT/scripts/check-body-len.py" 2>/dev/null | head -1)
    echo "ℹ️  ${SL}（python3 scripts/check-body-len.py 看明细）"
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "refs/heads/main" ] || continue
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

    OUT=$(npx --yes vercel ls tradego-fasteners --json 2>/dev/null)
    STATE=$(printf '%s' "$OUT" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin); ds = d.get("deployments") or d
except Exception:
    print("unknown"); raise SystemExit
busy = [x for x in ds if x.get("state") in ("QUEUED", "BUILDING", "INITIALIZING")]
for x in busy[:3]:
    m = x.get("meta") or {}
    print("busy", x.get("state"), m.get("githubCommitSha", "")[:7])
' 2>/dev/null)

    if printf '%s' "$STATE" | grep -q '^busy'; then
        echo "──────────────────────────────────────────────"
        echo "⛔ 构建队列还没空，这次 push 先攒着："
        printf '%s\n' "$STATE" | sed 's/^/   /'
        echo "   等最新一次 Ready 后再推；确需立即部署用：DEPLOY_FORCE=1 git push"
        echo "──────────────────────────────────────────────"
        exit 1
    fi
done
exit 0
