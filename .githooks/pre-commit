#!/bin/bash
# pre-commit（软护栏）：防止"顺手 git add -A"把别人的批量 i18n/content 改动混进一次部署。
# 批量提交只警告不阻断；文章改动则过「内容契约」门禁（只拦基线之外的新增问题）。
set -u
STAGED=$(git diff --cached --name-only)
[ -z "$STAGED" ] && exit 0
N_CONTENT=$(printf '%s\n' "$STAGED" | grep -cE '^(content|public/images)/' || true)
N_ALL=$(printf '%s\n' "$STAGED" | wc -l | tr -d ' ')
if printf '%s\n' "$STAGED" | grep -qE '^logs/'; then
  echo "⚠️  本次提交包含 logs/ 下的文件（应被 gitignore，检查一下）"
fi
if [ "$N_CONTENT" -gt 20 ]; then
  echo "⚠️  本次提交含 ${N_CONTENT} 个 content/public 文件（共 ${N_ALL} 个），像批量改动："
  printf '%s\n' "$STAGED" | grep -E '^(content|public/images)/' | head -8
  echo "    若非本次任务所需，用 git restore --staged <path> 撤回。"
  DATE=$(TZ=Asia/Shanghai date '+%F %T')
  mkdir -p logs
  echo "$DATE | bulk-commit $N_CONTENT/$N_ALL | $(git log -1 --format=%s 2>/dev/null || echo '-')" >> logs/vercel-bulk-commit.log 2>/dev/null || true
fi

# ── 跨领域混合提交告警（两个 agent 同仓库时，git commit -a 会把对方的 WIP 卷进来）──
# 判据：同时出现 content/ 与 src|public|scripts|docs，且各自 ≥1 个文件、总数 ≥4。
# 不阻断（合法的跨领域改动也存在），但会打出"像不像 commit -a"的判断依据，并留痕。
N_SRC=$(printf '%s\n' "$STAGED" | grep -cE '^(src|public|scripts|docs|package\.json|next\.config\.ts|vercel\.json)' || true)
if [ "$N_CONTENT" -ge 1 ] && [ "$N_SRC" -ge 1 ] && [ "$N_ALL" -ge 4 ]; then
  echo "⚠️  跨领域混合提交：content/public ${N_CONTENT} 个 + src/scripts/docs ${N_SRC} 个（共 ${N_ALL} 个）"
  echo "    如果是 git commit -a / git add -A 带进来的另一个 agent 的在途改动，请改用："
  echo "    git commit -- <你这轮真正改的路径>     （只提交自己的文件，避免归属错乱）"
  DATE2=$(TZ=Asia/Shanghai date '+%F %T')
  mkdir -p logs
  echo "$DATE2 | mixed-commit content=$N_CONTENT src=$N_SRC total=$N_ALL" >> logs/vercel-bulk-commit.log 2>/dev/null || true
fi

# ── 校验器自检（4 个反向用例）：防止并线写坏脚本后"全库干净"的假通过 ──────────
python3 scripts/contract_selftest.py --quiet >/tmp/cc-selftest.log 2>&1 || {
  echo "❌ 内容契约校验器自检未通过，先修脚本（详见 /tmp/cc-selftest.log）"
  exit 1
}

# ── 内容契约门禁（只校验本次改动的文章，只拦基线之外的新增问题）────────────
# 全量报告：python3 scripts/content_contract.py
# 重刷基线：python3 scripts/content_contract.py --write-baseline content/contract-baseline.json
if [ "${CONTENT_CONTRACT_SKIP:-0}" != "1" ]; then
  ART=$(printf '%s\n' "$STAGED" | grep -E '^content/articles/[^/]+\.json$' || true)
  if [ -n "$ART" ]; then
    BASE="content/contract-baseline.json"
    NEW=0
    SLUGS=$(printf '%s\n' "$ART" | sed -E 's#content/articles/([^/]+)\.json#\1#')
    while IFS= read -r S; do
      [ -z "$S" ] && continue
      [ -f "content/articles/$S.json" ] || continue
      if [ -f "$BASE" ]; then
        python3 scripts/content_contract.py --baseline "$BASE" --slug "$S" --quiet >"/tmp/cc-$S.log" 2>&1
      else
        python3 scripts/content_contract.py --slug "$S" --quiet >"/tmp/cc-$S.log" 2>&1
      fi
      if [ $? -eq 1 ]; then
        echo "⛔ 内容契约未通过：$S"
        sed -n '/新增 BLOCK/,$p' "/tmp/cc-$S.log" | head -12
        NEW=1
      fi
    done <<< "$SLUGS"
    if [ "$NEW" = "1" ]; then
      echo "   修完再提交；确需绕过：CONTENT_CONTRACT_SKIP=1 git commit ..."
      exit 1
    fi
  fi
fi
exit 0
