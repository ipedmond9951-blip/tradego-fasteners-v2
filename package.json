{
  "name": "tradego-fasteners-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings 4",
    "postbuild": "next-sitemap",
    "content:contract": "python3 scripts/content_contract.py",
    "content:contract:fix": "python3 scripts/fix_content_contract.py",
    "content:contract:baseline": "python3 scripts/content_contract.py --write-baseline content/contract-baseline.json",
    "content:contract:backlog": "python3 scripts/content_contract_backlog.py",
    "content:gate": "python3 scripts/content_gate.py",
    "content:gate:brief": "python3 scripts/content_gate.py --brief",
    "content:append": "python3 scripts/append_body.py",
    "content:selftest": "python3 scripts/contract_selftest.py",
    "check:claims": "python3 scripts/check-claims.py",
    "check:social": "python3 scripts/social-link-check.py"
  },
  "dependencies": {
    "@google-analytics/data": "^5.2.2",
    "@vercel/speed-insights": "^2.1.0",
    "axios": "^1.15.2",
    "next": "16.2.3",
    "next-sitemap": "^4.2.3",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "playwright": "^1.59.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "browserslist": [
    "chrome >= 93",
    "firefox >= 90",
    "safari >= 15",
    "edge >= 93",
    "not dead"
  ]
}
